# ============================================================
#  MCP — Unity 游戏框架
#  .gitignore
#
#  原则：
#    1) 生成物一律不提交（能重建）
#    2) 任何凭据 / 账号数据 / 密钥一律不提交（仓库是公开的）
# ============================================================

# ============================================================
#  ★ 敏感数据 —— 绝不能提交（任意层级都匹配）
# ============================================================
# 服务端账号库（SQLite，含真实账号：根目录 / Assets / ServerHost 三处都可能出现）
GameData/
# 本地存档（含登录密码 / token / 设备信息）
LocalData/
# 兜底：任何数据库文件
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# 凭据类文件（兜底，防止以后手滑放进来）
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
*.cer
*.crt
.env
.env.*
secrets.*
*.credentials
appsettings.*.json

# ============================================================
#  Unity 自动生成（体积大，可重建）
# ============================================================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# ============================================================
#  本工程生成物
# ============================================================
# YooAsset 资源构建产物（菜单 Tools/YooAsset/2 重建）
/Bundles/
# 同步给本地资源服务器的产物（菜单 Tools/YooAsset/6 重建）
/ServerData/
# 拷进首包的内置资源（同上，菜单 2 重建）
/Assets/StreamingAssets/yoo/
# YooAsset 客户端下载缓存
/yoo/
# 运行时日志
/GameLogs/

# ============================================================
#  Unity / IDE 自动生成的解决方案与工程文件
#  （只匹配根目录；手写的 ServerHost/*.csproj 与
#    Tools/ConfigTool/*.csproj 在子目录，不受影响）
# ============================================================
/*.csproj
/*.sln
.vs/
.vsconfig
.idea/
.vscode/
*.user
*.userprefs
*.suo
*.tmp
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db
# 托管调试符号（DOTween 等第三方带进来的）
*.mdb

# ============================================================
#  服务端 / 工具的构建输出
# ============================================================
ServerHost/bin/
ServerHost/obj/
Tools/*/bin/
Tools/*/obj/
Tools/*/publish/

# ============================================================
#  内嵌第三方包里的示例工程
#  （Samples~ 约 29 MB；Unity 本来就不导入 ~ 结尾的目录）
# ============================================================
Packages/com.tuyoogame.yooasset/Samples~/

# ============================================================
#  打包产物
# ============================================================
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# ============================================================
#  系统垃圾
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
sysinfo.txt
